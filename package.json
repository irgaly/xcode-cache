{
  "name": "xcode-cache",
  "version": "1.9.2",
  "main": "dist/main/index.js",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "ncc build src/main.ts -o dist/main --source-map --license licenses.txt && ncc build src/post.ts -o dist/post --source-map --license licenses.txt && ln -sf ../lib dist/",
    "main": "ts-node src/main.ts",
    "post": "ts-node src/post.ts"
  },
  "dependencies": {
    "@actions/cache": "6.2.0",
    "@actions/core": "3.0.0",
    "@actions/exec": "3.0.0",
    "@actions/glob": "0.7.0",
    "@actions/github": "9.1.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vercel/ncc": "0.44.1",
    "ts-node": "10.9.1",
    "typescript": "6.0.2"
  }
}
